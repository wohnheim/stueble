{
  "name": "stueble",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "yarn run bundle-asyncapi && vite dev",
    "build": "vite build && SUPPRESS_NO_CONFIG_WARNING=1 asyncapi bundle ./build/api-spec/asyncapi.yaml -o ./build/api-spec/bundled-asyncapi.yaml",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "pwassets": "pwa-asset-generator ./static/favicon.svg ./static/pwa-assets/ -v /pwa-assets -o -b '#0e1415' -e -p 15%",
    "bundle-asyncapi": "SUPPRESS_NO_CONFIG_WARNING=1 asyncapi bundle ./static/api-spec/asyncapi.yaml -o ./static/api-spec/bundled-asyncapi.yaml"
  },
  "devDependencies": {
    "@asyncapi/cli": "^6.2.0",
    "@asyncapi/web-component": "^3.1.8",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@stoplight/elements": "^9.0.25",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@typescript/native": "npm:typescript@7",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "@zxing/library": "^0.23.0",
    "baseline-browser-mapping": "^2.11.26",
    "beercss": "^5.0.3",
    "dayjs": "^1.11.23",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "idb": "^8.0.3",
    "msgpackr": "^2.1.0",
    "nanoid": "^6.0.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "pwa-asset-generator": "^8.1.7",
    "qrcode": "^1.5.4",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "~6",
    "vite": "^8.3.1",
    "vite-plugin-environment": "^1.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "yarn-upgrade-all": "^0.8.1",
    "zod": "^4.6.5"
  },
  "type": "module",
  "dependencies": {}
}
