{
  "name": "stueble",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "yarn run bundle-asyncapi && vite dev",
    "build": "vite build && SUPPRESS_NO_CONFIG_WARNING=1 asyncapi bundle ./build/api-spec/asyncapi.yaml -o ./build/api-spec/bundled-asyncapi.yaml",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "pwassets": "pwa-asset-generator ./static/favicon.svg ./static/pwa-assets/ -v /pwa-assets -o -b '#0e1415' -e -p 15%",
    "bundle-asyncapi": "SUPPRESS_NO_CONFIG_WARNING=1 asyncapi bundle ./static/api-spec/asyncapi.yaml -o ./static/api-spec/bundled-asyncapi.yaml"
  },
  "devDependencies": {
    "@asyncapi/cli": "^6.0.0",
    "@asyncapi/web-component": "^2.6.5",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@stoplight/elements": "^9.0.16",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "@zxing/library": "^0.21.3",
    "beercss": "^4.0.19",
    "dayjs": "^1.11.20",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.16.0",
    "idb": "^8.0.3",
    "msgpackr": "^1.11.9",
    "nanoid": "^5.1.7",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "pwa-asset-generator": "^8.1.4",
    "qrcode": "^1.5.4",
    "svelte": "^5.55.0",
    "svelte-check": "^4.4.5",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-environment": "^1.1.3",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-static-copy": "^4.0.0",
    "yarn-upgrade-all": "^0.7.5",
    "zod": "^4.3.6"
  },
  "type": "module",
  "dependencies": {}
}
